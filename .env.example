# ─── Supabase (Phase 1 DB + Phase 2 auth) ────────────────────────────
# Create a project at https://supabase.com; grab all four from Settings → API.
# The service-role key bypasses RLS and is used only server-side.
# The anon (public) key + URL are safe to expose to the browser — they
# power the auth flow (Supabase Auth signIn/signUp/session cookies).
# In Supabase Dashboard: Authentication → Providers → Email should be
# enabled (default) and "Confirm email" should be toggled OFF so users
# log in immediately after registering.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Inngest (Phase 2 async runner) ──────────────────────────────────
# The Inngest step-function runner processes /api/portals/[id]/execute
# out of band so imports outlive the request (tab close, timeout, crash).
#
# Local dev: leave both blank and run `pnpm dev:inngest` in a second
# terminal — that launches the Inngest CLI dev server, which talks to
# /api/inngest unauthenticated. The dashboard is at http://localhost:8288.
#
# Production: create an Inngest Cloud app at https://app.inngest.com,
# then copy the Event Key + Signing Key from the app's settings.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Portal token encryption ──────────────────────────────────────────
# 32-byte key, base64-encoded. Rotate this and you lose access to every
# stored HubSpot token — treat as long-lived, back it up.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTAL_TOKEN_ENCRYPTION_KEY=

# ─── Spike scripts only (Phase 0) ─────────────────────────────────────
# Once F1 is wired up, portals come from the Supabase `portals` table
# and these are no longer read by app code — they remain only for the
# scripts under scripts/spike/ that still run one-off against your dev
# portal.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Portal (Hub) ID — top-right of the HubSpot UI under your account name.
HUBSPOT_PORTAL_ID=00000000
